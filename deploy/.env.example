# ==============================================================
# LuxEstate CRM Backend - Environment Variables
# Copy this file to the VM as ~/the-final-3/.env and fill values
# ==============================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Supabase (REQUIRED) ---
# From: Supabase Dashboard -> Project Settings -> API
# Project URL (e.g., https://abcdefghijklm.supabase.co)
SUPABASE_URL=
# service_role key (NOT the anon/public key)
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (REQUIRED) ---
# From: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Must use the connection pooling string (port 6543) for production
DATABASE_URL=

# --- OpenAI (optional - needed for AI features) ---
OPENAI_API_KEY=

# --- WhatsApp Webhook (optional - needed for WhatsApp lead sync) ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

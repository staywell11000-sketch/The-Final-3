{
  "framework": null,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard/:path*", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" },
    { "source": "/sign-in", "destination": "/" },
    { "source": "/sign-up", "destination": "/" },
    { "source": "/onboarding", "destination": "/" },
    { "source": "/accept-invite", "destination": "/" },
    { "source": "/forgot-password", "destination": "/" }
  ]
}
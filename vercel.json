{
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/luxestate run build",
  "outputDirectory": "artifacts/luxestate/dist/public",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter @workspace/luxestate run dev",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
